# PocketBase URL (internal network — used by SvelteKit server at runtime)
# Docker Compose: http://pocketbase:8090
# Railway private network: http://<railway-private-domain>:8090
POCKETBASE_URL=http://127.0.0.1:8090

# PocketBase public URL (used during Railway build phase when private network is unavailable)
# Set this to your Railway PocketBase service's public domain
PUBLIC_POCKETBASE_URL=https://your-pocketbase-service.up.railway.app

# URL that the SvelteKit server uses to reach PocketBase (server-to-server)
POCKETBASE_URL=http://pocketbase:8090

# URL that the browser uses to reach PocketBase (for client-side SDK calls, if any)
PUBLIC_POCKETBASE_URL=http://localhost:8090

# The public origin of the SvelteKit app (used by adapter-node for CSRF protection)
ORIGIN=http://localhost:3000

# Set to "production" in deployed environments
NODE_ENV=production
